APP_NAME=AutonomusAI
APP_ENV=development
API_V1_PREFIX=/api/v1

# MySQL Database URL (replace 'YOUR_MYSQL_PASSWORD' with your local MySQL password):
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/autonomusai

# Groq AI Provider (free API key from https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=60

# Workflow Limits
MAX_REPAIR_ATTEMPTS=3
MAX_FILES_PER_SESSION=20
MAX_SOURCE_FILE_SIZE_BYTES=200000
MAX_SESSION_SOURCE_SIZE_BYTES=1000000
MAX_EXECUTION_SECONDS=10
MAX_STDOUT_BYTES=50000

# Sandbox Security Boundary
SANDBOX_ENABLED=false

# Frontend CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
